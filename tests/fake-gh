#!/usr/bin/env python3
import json
import os
from pathlib import Path
import sys

state_path = Path(os.environ["FAKE_GH_STATE"])
state = json.loads(state_path.read_text())
args = sys.argv[1:]
if args[0] == "api":
    status = state.get("status", 200 if "release" in state else 404)
    print(f"HTTP/2.0 {status} Response\r\n\r\n", end="")
    if status == 200:
        print(json.dumps(state["release"]))
    else:
        print(json.dumps({"message": "Not Found" if status == 404 else "API failure"}))
        print(f"gh: API failure (HTTP {status})", file=sys.stderr)
        sys.exit(1)
elif args[:2] == ["release", "create"]:
    state["create_attempted"] = True
    state_path.write_text(json.dumps(state))
    if state.get("create_failure"):
        print("Release creation failed", file=sys.stderr)
        sys.exit(1)
    if "--verify-tag" not in args or "--notes-file" not in args:
        sys.exit("unsafe release command")
    def value(flag):
        return args[args.index(flag) + 1]
    assets = args[args.index("--") + 1:]
    names = [Path(p).name for p in assets]
    if len(names) != len(set(names)):
        sys.exit("GitHub upload rejected: duplicate asset name (HTTP 422)")
    state["release"] = {
        "tag_name": args[2],
        "name": value("--title"),
        "body": Path(value("--notes-file")).read_text(),
        "assets": {Path(p).name: Path(p).read_text() for p in assets},
        "html_url": "https://github.com/example/project/releases/tag/" + args[2],
    }
    state_path.write_text(json.dumps(state))
    print(state["release"]["html_url"])
else:
    sys.exit("Unexpected gh operation: " + repr(args))
